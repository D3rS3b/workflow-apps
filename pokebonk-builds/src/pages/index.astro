---
import "../styles/global.css";
import data from "../data/builds.json";

const { builds, sample, updatedAt, source } = data;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pokebonk Builds</title>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100">
    <header class="border-b border-slate-800 bg-slate-900/60">
      <div class="mx-auto max-w-5xl px-4 py-6">
        <h1 class="text-3xl font-bold tracking-tight">Pokebonk Builds</h1>
        <p class="mt-1 text-sm text-slate-400">
          Actualizado: {updatedAt} · <span id="count">{builds.length}</span> builds
        </p>
      </div>
    </header>

    {sample && (
      <div class="bg-amber-500/15 text-amber-300 text-sm text-center py-2 px-4">
        ⚠ Datos de ejemplo: {source}
      </div>
    )}

    <main class="mx-auto max-w-5xl px-4 py-6">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <input
          id="search"
          type="search"
          placeholder="Buscar por Pokémon, movimiento, objeto, rol…"
          class="w-full sm:max-w-md rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm outline-none focus:border-indigo-400"
        />
        <div class="flex flex-wrap gap-2">
          <button data-export="json" class="btn">Descargar JSON</button>
          <button data-export="csv" class="btn">Descargar CSV</button>
          <button data-export="copy" class="btn">Copiar texto</button>
        </div>
      </div>

      <ul id="list" class="mt-6 grid gap-4 sm:grid-cols-2">
        {builds.map((b) => (
          <li
            class="build rounded-xl border border-slate-800 bg-slate-900 p-4"
            data-id={b.id}
            data-search={[b.name, b.pokemon, b.role, b.ability, b.item, b.nature, ...b.moves].join(" ").toLowerCase()}
          >
            <div class="flex items-baseline justify-between gap-2">
              <h2 class="text-lg font-semibold">{b.pokemon}</h2>
              <span class="rounded-full bg-indigo-500/20 px-2 py-0.5 text-xs text-indigo-300">{b.role}</span>
            </div>
            <p class="text-sm text-slate-400">{b.name}</p>
            <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-sm">
              <dt class="text-slate-500">Habilidad</dt><dd>{b.ability}</dd>
              <dt class="text-slate-500">Objeto</dt><dd>{b.item}</dd>
              <dt class="text-slate-500">Naturaleza</dt><dd>{b.nature}</dd>
              <dt class="text-slate-500">EVs</dt><dd>{b.evs}</dd>
            </dl>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {b.moves.map((m) => (
                <li class="rounded-md bg-slate-800 px-2 py-1 text-xs">{m}</li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
      <p id="empty" class="mt-10 hidden text-center text-slate-500">Ningún resultado.</p>
    </main>

    <script id="builds-data" type="application/json" set:html={JSON.stringify(builds)} />

    <script>
      type Build = {
        id: string; name: string; pokemon: string; role: string; ability: string;
        item: string; nature: string; evs: string; moves: string[]; author?: string;
      };

      const all: Build[] = JSON.parse(document.getElementById("builds-data")!.textContent!);
      const items = [...document.querySelectorAll<HTMLElement>(".build")];
      const search = document.getElementById("search") as HTMLInputElement;
      const count = document.getElementById("count")!;
      const empty = document.getElementById("empty")!;

      const visible = (): Build[] => {
        const ids = new Set(items.filter((el) => !el.hidden).map((el) => el.dataset.id));
        return all.filter((b) => ids.has(b.id));
      };

      search.addEventListener("input", () => {
        const q = search.value.trim().toLowerCase();
        for (const el of items) el.hidden = !!q && !el.dataset.search!.includes(q);
        const n = items.filter((el) => !el.hidden).length;
        count.textContent = String(n);
        empty.classList.toggle("hidden", n > 0);
      });

      const download = (name: string, type: string, text: string) => {
        const url = URL.createObjectURL(new Blob([text], { type }));
        const a = Object.assign(document.createElement("a"), { href: url, download: name });
        a.click();
        URL.revokeObjectURL(url);
      };

      const csvCell = (v: string) => `"${v.replaceAll('"', '""')}"`;

      const toCsv = (rows: Build[]) =>
        ["id,name,pokemon,role,ability,item,nature,evs,moves,author"]
          .concat(rows.map((b) =>
            [b.id, b.name, b.pokemon, b.role, b.ability, b.item, b.nature, b.evs, b.moves.join(" / "), b.author ?? ""]
              .map(csvCell).join(",")))
          .join("\n");

      const toText = (rows: Build[]) =>
        rows.map((b) =>
          `${b.pokemon} @ ${b.item}\nAbility: ${b.ability}\nEVs: ${b.evs}\n${b.nature} Nature\n` +
          b.moves.map((m) => `- ${m}`).join("\n")).join("\n\n");

      document.querySelectorAll<HTMLButtonElement>("[data-export]").forEach((btn) =>
        btn.addEventListener("click", async () => {
          const rows = visible();
          const kind = btn.dataset.export;
          if (kind === "json") download("pokebonk-builds.json", "application/json", JSON.stringify(rows, null, 2));
          else if (kind === "csv") download("pokebonk-builds.csv", "text/csv;charset=utf-8", toCsv(rows));
          else {
            await navigator.clipboard.writeText(toText(rows));
            const old = btn.textContent;
            btn.textContent = "¡Copiado!";
            setTimeout(() => (btn.textContent = old), 1500);
          }
        })
      );
    </script>
  </body>
</html>

<style is:global>
  @reference "tailwindcss";
  .btn {
    @apply rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-sm font-medium
      hover:bg-indigo-500 hover:border-indigo-400 transition-colors cursor-pointer;
  }
</style>
